"X-Domain: rmd-backup-wordpress\n"

msgid "RMD Backup WordPress requires PHP %1$s or newer. This site runs PHP %2$s, so the plugin stays inactive."
msgstr "RMD Backup WordPress benötigt PHP %1$s oder neuer. Diese Website läuft mit PHP %2$s, daher bleibt das Plugin inaktiv."

msgid "Backups"
msgstr "Backups"

msgid "Cancel the running backup?"
msgstr "Laufendes Backup abbrechen?"

msgid "Delete this permanently?"
msgstr "Endgültig löschen?"

msgid "Starting backup …"
msgstr "Backup wird gestartet …"

msgid "The request failed:"
msgstr "Die Anfrage ist fehlgeschlagen:"

msgid "Continue"
msgstr "Fortsetzen"

msgid "Cancel backup"
msgstr "Backup abbrechen"

msgid "The backup stops after the current step …"
msgstr "Das Backup stoppt nach dem aktuellen Schritt …"

msgid "Close"
msgstr "Schließen"

msgid "View log"
msgstr "Log ansehen"

msgid "Warnings"
msgstr "Warnungen"

msgid "You can leave this page; the backup continues in the background."
msgstr "Du kannst diese Seite verlassen, das Backup läuft im Hintergrund weiter."

msgid "Backup finished."
msgstr "Backup abgeschlossen."

msgid "Backup finished with warnings."
msgstr "Backup mit Warnungen abgeschlossen."

msgid "Backup failed:"
msgstr "Backup fehlgeschlagen:"

msgid "Backup cancelled."
msgstr "Backup abgebrochen."

msgid "You are not allowed to access this page."
msgstr "Du darfst diese Seite nicht aufrufen."

msgid "Profiles"
msgstr "Profile"

msgid "Logs"
msgstr "Logs"

msgid "Settings"
msgstr "Einstellungen"

msgid "There are no profiles."
msgstr "Es gibt keine Profile."

msgid "Add a profile"
msgstr "Profil anlegen"

msgid "Profile"
msgstr "Profil"

msgid "Back up now"
msgstr "Jetzt sichern"

msgid "Scheduled backups"
msgstr "Geplante Backups"

msgid "No profile runs on a schedule."
msgstr "Kein Profil läuft zeitgesteuert."

msgid "Set a schedule in a profile"
msgstr "Zeitplan in einem Profil festlegen"

msgid "Next run"
msgstr "Nächster Lauf"

