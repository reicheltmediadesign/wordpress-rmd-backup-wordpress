msgid "RMD Backup WordPress requires PHP %1$s or newer. This site runs PHP %2$s, so the plugin stays inactive."
msgstr "RMD Backup WordPress benötigt PHP %1$s oder neuer. Diese Website läuft mit PHP %2$s, daher bleibt das Plugin inaktiv."

msgid "Backups"
msgstr "Backups"

msgid "Cancel the running backup?"
msgstr "Laufendes Backup abbrechen?"

msgid "Delete this permanently?"
msgstr "Endgültig löschen?"

msgid "Starting backup …"
msgstr "Backup wird gestartet …"

